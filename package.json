{
  "name": "vantra-backend",
  "version": "0.1.0",
  "description": "Vantra fleet telemetry backend",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:fleet-api": "node dist/src/apps/fleet-api/main.js",
    "start:ingestion": "node dist/src/apps/ingestion/main.js",
    "start:alerting": "node dist/src/apps/alerting/main.js",
    "dev:fleet-api": "ts-node-dev --respawn src/apps/fleet-api/main.ts",
    "dev:ingestion": "ts-node-dev --respawn src/apps/ingestion/main.ts",
    "dev:alerting": "ts-node-dev --respawn src/apps/alerting/main.ts",
    "seed": "ts-node scripts/seed.ts",
    "migrate": "ts-node scripts/migrate-compass.ts",
    "simulate": "ts-node scripts/simulate-devices.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:int": "jest --runInBand --testRegex \"\\.int-spec\\.ts$\""
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.6",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/schedule": "^4.0.1",
    "@nestjs/swagger": "^7.4.2",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.11.1",
    "mongoose": "^8.2.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$"
  }
}
