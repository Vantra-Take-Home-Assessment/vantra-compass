MONGO_URI=mongodb://localhost:27017/vantra
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
INTERNAL_TOKEN=change-me-too
# Local (non-docker) ports: fleet-api 3001, ingestion 3002, alerting 3003
FLEET_API_URL=http://localhost:3001
INGESTION_URL=http://localhost:3002
# Optional: deliver alerts to a webhook instead of logging them
NOTIFY_WEBHOOK_URL=
NOTIFY_SIMULATED_FAILURE_RATE=0
# Parallel alert senders per alerting replica
NOTIFY_CONCURRENCY=16
